#!/usr/bin/env bash
# ralph-bootstrap — drop the Ralph autonomous-loop orchestrator into a repo/worktree.
#
# Copies ralph.sh + the prompt template into <target>/scripts/ralph/, then excludes
# scripts/ralph/ from git so the loop's runtime churn (prd.json, progress.txt, archive/)
# never pollutes the feature branch — Ralph's real output is the code commits it makes.
#
# Usage: ralph-bootstrap [target-dir]   (default: cwd)
# Normally invoked by `wt --ralph <epic>`; runnable standalone too.
set -euo pipefail

# Ralph source dir. install.sh symlinks share/ralph → ~/.claude/ralph.
# Override w/ WTLANES_RALPH if running from a clone.
SRC="${WTLANES_RALPH:-$HOME/.claude/ralph}"
TARGET="${1:-$PWD}"

[ -d "$TARGET" ] || { echo "ralph-bootstrap: target not a dir: $TARGET" >&2; exit 1; }
[ -d "$TARGET/.git" ] || git -C "$TARGET" rev-parse --git-dir >/dev/null 2>&1 || {
  echo "ralph-bootstrap: $TARGET is not a git repo" >&2; exit 1; }

DEST="$TARGET/scripts/ralph"
mkdir -p "$DEST"
cp "$SRC/ralph.sh" "$DEST/ralph.sh"
cp "$SRC/CLAUDE.md.template" "$DEST/CLAUDE.md"
cp "$SRC/prd.json.example" "$DEST/prd.json.example"
chmod +x "$DEST/ralph.sh"

# Keep the whole loop dir out of git — disk-persistent across iterations, never committed.
GIT_DIR="$(git -C "$TARGET" rev-parse --git-dir)"
EXCLUDE="$GIT_DIR/info/exclude"
mkdir -p "$(dirname "$EXCLUDE")"
grep -qxF 'scripts/ralph/' "$EXCLUDE" 2>/dev/null || echo 'scripts/ralph/' >> "$EXCLUDE"

echo "ralph-bootstrap: scripts/ralph/ ready in $TARGET"
echo "  next: /prd <brief>  →  /ralph (convert to prd.json)  →  ./scripts/ralph/ralph.sh --tool claude"
echo "  tune scripts/ralph/CLAUDE.md — set the typecheck/test commands for this project"
