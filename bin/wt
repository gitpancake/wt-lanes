#!/usr/bin/env bash
# wt — spin up a worktree lane in one command.
#
# Usage:
#   wt [--type <prefix>] <task-slug-or-ticket>     # single lane, one-shot pi (default)
#   wt --branch <name> [--type ...] <slug>         # single lane on an existing branch (e.g. a PR head)
#   wt --base <ref> [--type ...] <slug>            # base the new lane branch on <ref> (default: origin default branch)
#   wt --dag [--type <prefix>] <TICKET>            # parse plan DAG, spawn ready-set lanes (dormant)
#   wt --resolve [--type <prefix>] <TICKET>        # re-spawn ready-set after slices merged (dormant)
#   wt --print-brief <task-slug-or-ticket>         # resolve + print the brief path, then exit
#
# Single-lane behavior:
#   The task arg resolves to a brief, in order: Linear id (frontmatter `linear:`),
#   then slug (filename), then epic folder name. Contract: $TICKETS_DIR/README.md
#   ($TICKETS_DIR defaults to ~/.claude/tickets; the zsh chpwd hook scopes it to
#   ~/.claude/tickets/<project>/ inside a repo).
#   wt auth-refactor                # slug → $TICKETS_DIR/<area>/auth-refactor.md
#   wt TEAM-1234                    # Linear id → brief whose frontmatter `linear:` matches
#                                   (the brief must already exist locally — /scope it if not)
#   wt raw-throwaway-slug           # slug with no brief → worktree only, no auto-kickoff
#   wt billing-epic                 # epic folder slug → _epic.md brief
#   wt auth-refactor-round-2        # trailing descriptor → 2nd lane on the same brief
#   wt --type fix some-bug-slug     # branch fix/some-bug-slug
#
# Type prefix defaults to `feature`. Override with --type or WT_TYPE env.
# Common values: feature, fix, chore, task, refactor.
#
# DAG mode:
#   wt --dag TEAM-1234  → reads ~/.claude/plans/TEAM-1234.md slice-dag block,
#                       spawns lanes only for slices whose `needs` are merged
#                       and whose `touches` don't conflict with already-ready
#                       siblings. No DAG block / single slice → falls back to
#                       single-lane.
#   wt --resolve TEAM-1234 → after some slices merge, re-compute ready set and
#                       spawn newly-unblocked lanes. Skips slices already in
#                       flight (worktree exists).
#
# Env knobs:
#   WT_TYPE=          branch type prefix (default: feature)
#   WT_BASE=          base ref for new lane branches (same as --base)
#   WT_NO_FETCH=1     skip pre-spawn fetch + ff
#   WT_NO_DEPS=1      skip node_modules provisioning (lane installs its own)
#   WT_LAYOUT=        pane|window|session (default: window)
#   WT_AGENT_CMD='pi ...' full launch command override
#   WT_ULTRACODE=1    opt a Claude lane INTO ultracode mode (default: off since
#                     2026-09-10 — xhigh thinking is retained across the lane's
#                     single mega-turn, ~35% of ctx growth, and it licenses fan-out)
#   WT_PI_MODEL=openai-codex/gpt-5.5  Pi model override
#   WT_DRY_RUN=1      DAG mode only — print what would spawn, don't actually
#   WT_DAG=1          equivalent to --dag flag
#
# Effect (per lane):
#   - Worktree at <repo>/.claude/worktrees/<slug>
#   - Branch <type>/<slug> off origin's default branch — HEAD only when the
#     cockpit IS the default branch; --base/WT_BASE overrides; skipped if the
#     branch already exists
#   - Per-lane port stamped in .env.local.port (3100 + lane index)
#   - node_modules provisioned from the cockpit: symlinked for a plain repo,
#     APFS-cloned for a bun workspace, plus `bun install` when the lane's
#     lockfile differs. Opt out w/ WT_NO_DEPS=1.
#   - .claude/agent-state seeded as IDLE (visible to agent-board)
#   - In tmux: opens new window running pi, with optional initial prompt
#   - Outside tmux (agent Bash tools land here): opens the window in the `wt`
#     session and links it into the attached session so it shows up in the
#     user's cockpit. Opt out w/ WT_NO_LINK=1.
#   - No tmux at all: prints the path so you can cd in manually

set -euo pipefail

# ---- arg parse -------------------------------------------------------------

mode="single"
type_prefix="${WT_TYPE:-feature}"
branch_override=""
base_override="${WT_BASE:-}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dag)     mode="dag";     shift ;;
    --resolve) mode="resolve"; shift ;;
    --print-brief) mode="print-brief"; shift ;;
    --type)
      [[ -z "${2:-}" ]] && { echo "wt: --type requires an argument" >&2; exit 1; }
      type_prefix="$2"; shift 2 ;;
    --type=*)  type_prefix="${1#--type=}"; shift ;;
    --branch)
      [[ -z "${2:-}" ]] && { echo "wt: --branch requires an argument" >&2; exit 1; }
      branch_override="$2"; shift 2 ;;
    --branch=*) branch_override="${1#--branch=}"; shift ;;
    --base)
      [[ -z "${2:-}" ]] && { echo "wt: --base requires an argument" >&2; exit 1; }
      base_override="$2"; shift 2 ;;
    --base=*)  base_override="${1#--base=}"; shift ;;
    -h|--help) sed -n '2,/^$/{ s/^# \?//; p; }' "$0"; exit 0 ;;
    --)        shift; break ;;
    -*)        echo "wt: unknown flag $1 (try --help)" >&2; exit 1 ;;
    *)         break ;;
  esac
done
[[ "${WT_DAG:-}" == "1" && "$mode" == "single" ]] && mode="dag"

# --branch only makes sense for a single lane on a pre-existing branch.
[[ -n "$branch_override" && "$mode" != "single" ]] \
  && { echo "wt: --branch is single-lane only (not valid with --dag/--resolve)" >&2; exit 1; }

# Sanitize type prefix: lowercase, alnum + dash only.
type_prefix=$(printf '%s' "$type_prefix" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9-]//g')
[[ -z "$type_prefix" ]] && { echo "wt: invalid --type prefix" >&2; exit 1; }

raw=${1:-}
[[ -z "$raw" ]] && { echo "usage: wt [--dag|--resolve] [--type <prefix>] <task-slug-or-ticket>" >&2; exit 1; }

# Derive a slug descriptor from the plan's first heading.
#   '# TEAM-1234 — Add foo bar' → 'add-foo-bar'
derive_descriptor_from_plan() {
  local plan_file=$1 ticket_upper=$2 title desc
  [[ -f "$plan_file" ]] || return 1
  title=$(awk '/^# /{ sub(/^# +/, ""); print; exit }' "$plan_file")
  [[ -z "$title" ]] && return 1
  # Strip leading "TICKET" plus optional separator (— : -).
  title=$(printf '%s' "$title" | sed -E "s/^${ticket_upper}[[:space:]]*([—:-][[:space:]]*)?//I")
  desc=$(printf '%s' "$title" \
    | tr '[:upper:]' '[:lower:]' \
    | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//' \
    | cut -c1-50 \
    | sed -E 's/-+$//')
  [[ -z "$desc" ]] && return 1
  printf '%s' "$desc"
}

TICKETS_DIR="${TICKETS_DIR:-$HOME/.claude/tickets}"

# A brief may be a tombstone — first line `moved -> <path>`. Follow it to the real file.
follow_tombstone() {
  local f=$1 first target
  first=$(head -1 "$f" 2>/dev/null)
  if [[ "$first" =~ ^moved[[:space:]]-\>[[:space:]](.+)$ ]]; then
    target="${BASH_REMATCH[1]}"
    target="${target/#\~/$HOME}"
    [[ -f "$target" ]] && { printf '%s' "$target"; return 0; }
  fi
  printf '%s' "$f"
}

# Find a brief whose frontmatter `linear:` field equals <ID>.
find_ticket_by_linear() {
  grep -rlE "^linear:[[:space:]]+$1[[:space:]]*$" "$TICKETS_DIR" --include='*.md' 2>/dev/null | head -1
}

# Find a brief file named <slug>.md (also matches legacy <ID>.md files mid-migration).
find_ticket_file() {
  find "$TICKETS_DIR" -name "$1.md" -type f 2>/dev/null | head -1
}

# Find an epic directory named <slug> that contains an _epic.md.
find_epic_dir() {
  local d
  while IFS= read -r d; do
    [[ -f "$d/_epic.md" ]] && { printf '%s' "$d"; return 0; }
  done < <(find "$TICKETS_DIR" -type d -name "$1" 2>/dev/null)
  return 1
}

# Read the frontmatter `linear:` id from a brief (empty if none — i.e. a draft).
read_linear_id() {
  awk '
    /^---[[:space:]]*$/ { fm++; next }
    fm == 1 && /^linear:/ {
      sub(/^linear:[[:space:]]*/, ""); gsub(/[[:space:]]/, ""); print; exit
    }
    fm >= 2 { exit }
  ' "$1" 2>/dev/null | tr '[:lower:]' '[:upper:]'
}

# Resolve a bare id-or-slug to a brief. Order: Linear id (frontmatter) → slug
# (filename) → epic folder name. Sets ticket_file + is_epic. 0 = hit, 1 = miss.
resolve_brief() {
  local cand=$1 cand_upper f d
  cand_upper=$(printf '%s' "$cand" | tr '[:lower:]' '[:upper:]')
  ticket_file=""
  is_epic=0

  if [[ "$cand" =~ ^[A-Za-z]+-[0-9]+$ ]]; then
    f=$(find_ticket_by_linear "$cand_upper")
    [[ -z "$f" ]] && f=$(find_ticket_file "$cand_upper")   # legacy <ID>.md fallback
    if [[ -n "$f" ]]; then
      ticket_file=$(follow_tombstone "$f")
      [[ "$(basename "$ticket_file")" == "_epic.md" ]] && is_epic=1
      return 0
    fi
  fi

  f=$(find_ticket_file "$cand")
  if [[ -n "$f" ]]; then
    ticket_file=$(follow_tombstone "$f")
    [[ "$(basename "$ticket_file")" == "_epic.md" ]] && is_epic=1
    return 0
  fi

  d=$(find_epic_dir "$cand") || d=""
  if [[ -n "$d" ]]; then
    ticket_file="$d/_epic.md"
    is_epic=1
    return 0
  fi

  return 1
}

# Derive a slug descriptor from a synced ticket file's frontmatter `title:`.
derive_descriptor_from_ticket() {
  local ticket_file=$1 title desc
  [[ -f "$ticket_file" ]] || return 1
  title=$(awk '/^title:/{ sub(/^title:[[:space:]]*/, ""); print; exit }' "$ticket_file")
  [[ -z "$title" ]] && return 1
  desc=$(printf '%s' "$title" \
    | tr '[:upper:]' '[:lower:]' \
    | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//' \
    | cut -c1-50 \
    | sed -E 's/-+$//')
  [[ -z "$desc" ]] && return 1
  printf '%s' "$desc"
}

# Resolve <raw> to a brief + worktree slug.
#   TEAM-1234              → resolve by Linear id; slug = the brief's own slug
#   TEAM-1234-pr-feedback  → resolve TEAM-1234; slug = team-1234-pr-feedback (2nd lane on it)
#   auth-refactor          → resolve by slug, then epic folder name; slug = arg as-is
ticket=""
slug=""
ticket_file=""
plan_slug=""
is_epic=0

if [[ "$raw" =~ ^([A-Za-z]+-[0-9]+)(-.+)?$ ]]; then
  ticket=$(printf '%s' "${BASH_REMATCH[1]}" | tr '[:lower:]' '[:upper:]')
  ticket_lower=$(printf '%s' "$ticket" | tr '[:upper:]' '[:lower:]')
  tail="${BASH_REMATCH[2]:-}"
  resolve_brief "$ticket" || true
  if [[ -n "$tail" ]]; then
    # Explicit descriptor suffix → a second lane on the same brief.
    slug="${ticket_lower}${tail}"
    plan_slug="${ticket}${tail}"
  else
    plan_slug="$ticket"
    if [[ -n "$ticket_file" && "$is_epic" == "1" ]]; then
      slug=$(basename "$(dirname "$ticket_file")")
    elif [[ -n "$ticket_file" ]]; then
      base=$(basename "$ticket_file" .md)
      if [[ "$base" == "$ticket" ]]; then
        # Legacy <ID>.md brief — derive a descriptor from its title.
        descriptor=$(derive_descriptor_from_ticket "$ticket_file" || true)
        [[ -n "$descriptor" ]] && slug="${ticket_lower}-${descriptor}" || slug="$ticket_lower"
      else
        slug="$base"
      fi
    else
      slug="$ticket_lower"
    fi
  fi
else
  slug=$(printf '%s' "$raw" | tr '[:upper:]' '[:lower:]')
  plan_slug="$slug"
  resolve_brief "$slug" || true
  [[ -n "$ticket_file" && "$is_epic" == "1" ]] && slug=$(basename "$(dirname "$ticket_file")")
  [[ -n "$ticket_file" ]] && ticket=$(read_linear_id "$ticket_file")
fi

# --print-brief: resolve only, print the brief path, exit. /pickup calls this so
# the resolution logic lives in exactly one place.
if [[ "$mode" == "print-brief" ]]; then
  [[ -n "$ticket_file" ]] || { echo "wt: no brief found for '$raw'" >&2; exit 1; }
  printf '%s\n' "$ticket_file"
  exit 0
fi

repo=$(git rev-parse --show-toplevel 2>/dev/null) \
  || { echo "wt: not inside a git repo" >&2; exit 1; }

wt_dir="$repo/.claude/worktrees"
mkdir -p "$wt_dir"

# Pre-spawn fetch + ff. Skip with WT_NO_FETCH=1.
if [[ -z "${WT_NO_FETCH:-}" ]]; then
  git -C "$repo" fetch --quiet origin || echo "wt: warning, fetch failed" >&2
  current=$(git -C "$repo" rev-parse --abbrev-ref HEAD)
  if [[ "$current" == "main" || "$current" == "master" ]]; then
    if git -C "$repo" merge-base --is-ancestor HEAD "origin/$current" 2>/dev/null; then
      git -C "$repo" merge --ff-only "origin/$current" \
        || echo "wt: WARNING — local $current is BEHIND origin/$current and the ff failed (dirty tree?). Lanes will still base off origin/$current, but commit/stash your cockpit changes to unstick local $current." >&2
    fi
  fi
fi

# New lane branches base off origin's default branch, NOT the cockpit HEAD —
# a cockpit parked on a feature branch must not leak its history into fresh
# lanes (digest post-mortem epic, 2026-06-12: lanes spawned 22 commits behind
# main). When the cockpit IS the default branch we still prefer the fresh
# origin ref, falling back to HEAD only when local main is genuinely AHEAD of
# origin (deliberately-ahead unpushed commits). --base/WT_BASE overrides (e.g.
# /pickup fork-off onto a feature BASE).
lane_base_ref="$base_override"
if [[ -n "$lane_base_ref" ]]; then
  git -C "$repo" rev-parse --verify "${lane_base_ref}^{commit}" >/dev/null 2>&1 \
    || { echo "wt: base '$lane_base_ref' does not resolve to a commit" >&2; exit 1; }
else
  default_branch=$(git -C "$repo" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null) || true
  default_branch="${default_branch#origin/}"
  if [[ -z "$default_branch" ]]; then
    for default_cand in main master; do
      if git -C "$repo" rev-parse --verify "origin/$default_cand" >/dev/null 2>&1; then
        default_branch="$default_cand"; break
      fi
    done
  fi
  cockpit_branch=$(git -C "$repo" rev-parse --abbrev-ref HEAD)
  if [[ -n "$default_branch" && "$cockpit_branch" != "$default_branch" ]]; then
    lane_base_ref="origin/$default_branch"
    echo "wt: cockpit on '$cockpit_branch' — new lane branches base off origin/$default_branch (override with --base)" >&2
  elif [[ -n "$default_branch" ]] \
       && git -C "$repo" merge-base --is-ancestor HEAD "origin/$default_branch" 2>/dev/null; then
    # Cockpit IS the default branch: base off the freshly-fetched origin ref,
    # not local HEAD. Local $default_branch only advances on a *successful* ff,
    # and a dirty tree silently aborts it (PP §66: same bug class as the
    # 2026-06-12 fix above). Fall back to HEAD only when local main is genuinely
    # AHEAD of origin (deliberately-ahead unpushed commits).
    lane_base_ref="origin/$default_branch"
  elif [[ -n "$default_branch" ]] \
       && git -C "$repo" merge-base --is-ancestor "origin/$default_branch" HEAD 2>/dev/null; then
    # origin is an ancestor of HEAD: local $default_branch is ahead-only
    # (deliberately-unpushed commits). Preserve them as the lane base.
    lane_base_ref="HEAD"
  elif [[ -n "$default_branch" ]]; then
    # Neither is an ancestor of the other: local $default_branch has DIVERGED
    # from origin (e.g. a local-only docs commit sitting under commits that
    # landed on origin meanwhile). Basing off local HEAD would silently drop
    # every origin-only commit from new lanes (2026-07-02: every pickup lane
    # forked off a local main 11 commits behind origin). Prefer the fresh
    # origin ref and warn instead of guessing.
    echo "wt: local $default_branch has DIVERGED from origin/$default_branch — new lane branches base off origin/$default_branch (override with --base). Rebase local $default_branch onto origin/$default_branch to clear this." >&2
    lane_base_ref="origin/$default_branch"
  else
    lane_base_ref="HEAD"
  fi
fi

layout="${WT_LAYOUT:-window}"

# Lanes spawned by this invocation, counted by the WT_MAX_LANES guard in
# spawn_lane — pgrep can't see lanes whose tmux window exists but whose
# claude process hasn't booted yet (DAG mode spawns several back-to-back).
spawned_this_run=0

# ---- dependency provisioning ----------------------------------------------
# node_modules is gitignored, so `git worktree add` checks out zero deps and the
# lane pays a cold install. Two shapes, because they fail differently:
#   plain repo    -> symlink the cockpit's tree. Resolution already walks up to
#                    it for worktrees nested under the repo; the link makes that
#                    explicit and also covers off-repo worktrees.
#   bun workspace -> needs a real tree: root node_modules/<pkg> entries symlink
#                    to workspace sources, so a shared tree makes the lane import
#                    the COCKPIT's source instead of its own branch. `cp -c` is an
#                    APFS clone (copy-on-write), so N lanes cost ~one tree on disk.
# A lane whose lockfile differs from the cockpit's always gets its own tree plus a
# real install -- never a symlink, which would write through into the cockpit's
# node_modules. Opt out entirely with WT_NO_DEPS=1.
# ---- push guard ------------------------------------------------------------
# Every push from any worktree of the repo runs the repo's CI guards first
# (hooks/pre-push). Hooks live in the repo's common git dir, so one symlink
# covers the cockpit and every lane. A pre-push someone else installed is left
# alone and reported, never overwritten.
install_push_guard() {
  local repo=$1 hooks_dir hook src="${WT_HOME:-$HOME/.wt-lanes}/hooks/pre-push"
  hooks_dir=$(git -C "$repo" rev-parse --git-path hooks 2>/dev/null) || return 0
  [[ "$hooks_dir" = /* ]] || hooks_dir="$repo/$hooks_dir"
  hook="$hooks_dir/pre-push"
  if [[ -L "$hook" && "$(readlink "$hook")" == "$src" ]]; then return 0; fi
  if [[ -e "$hook" ]]; then
    echo "wt: $hook exists and is not the wt push guard — leaving it; the CI guards will not run before pushes from this repo" >&2
    return 0
  fi
  mkdir -p "$hooks_dir"
  ln -s "$src" "$hook"
  echo "wt: installed the CI push guard at $hook" >&2
}

provision_deps() {
  local repo=$1 wt=$2

  if [[ "${WT_NO_DEPS:-0}" == "1" ]]; then return 0; fi
  if [[ -e "$wt/node_modules" ]]; then return 0; fi
  if [[ ! -f "$wt/package.json" || ! -d "$repo/node_modules" ]]; then return 0; fi

  local lock="" candidate
  for candidate in bun.lock bun.lockb package-lock.json pnpm-lock.yaml yarn.lock; do
    if [[ -f "$wt/$candidate" && -f "$repo/$candidate" ]]; then lock=$candidate; break; fi
  done

  local stale_lock=0 needs_own_tree=0
  if [[ -n "$lock" ]] && ! cmp -s "$repo/$lock" "$wt/$lock"; then stale_lock=1; fi
  if grep -q '"workspaces"' "$repo/package.json"; then needs_own_tree=1; fi
  if (( stale_lock )); then needs_own_tree=1; fi

  if (( ! needs_own_tree )); then
    ln -s "$repo/node_modules" "$wt/node_modules"
    echo "  deps:     linked -> $repo/node_modules"
    return 0
  fi

  if ! cp -c -R "$repo/node_modules" "$wt/node_modules" 2>/dev/null; then
    cp -R "$repo/node_modules" "$wt/node_modules" 2>/dev/null || true
  fi

  # Workspace packages carry their own node_modules (bin shims, hoist-exempt
  # deps); the root tree alone leaves those broken.
  local nested rel
  while IFS= read -r nested; do
    rel=${nested#"$repo"/}
    if [[ -d "$wt/${rel%/node_modules}" && ! -e "$wt/$rel" ]]; then
      cp -c -R "$nested" "$wt/$rel" 2>/dev/null || cp -R "$nested" "$wt/$rel" 2>/dev/null || true
    fi
  done < <(find "$repo" -mindepth 2 -maxdepth 3 -type d -name node_modules \
             -not -path "$repo/node_modules/*" -not -path "$repo/.claude/*" 2>/dev/null || true)

  if (( ! stale_lock )); then
    echo "  deps:     cloned from cockpit (APFS CoW)"
    return 0
  fi

  echo "  deps:     cloned + reconciling ($lock differs from cockpit)"
  ( cd "$wt" && bun install >/dev/null 2>&1 ) || true
}

# Lanes that still need attention. A lane that is DONE, parked on the
# review-gate Monitor, or in a hold or yellow wait (holland, human,
# prompt-owner, review, external) waits on a reviewer or a named person, not
# on you, so it no longer uses a WT_MAX_LANES slot. Red pauses still count.
count_attention_lanes() {
  source "$HOME/.claude/state-codes.sh"
  local pid laneDir laneState laneCode count=0
  for pid in $(pgrep -f 'mcp\.lane\.json' 2>/dev/null); do
    laneDir=$(lsof -a -p "$pid" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p')
    laneState=$(head -1 "$laneDir/.claude/agent-state" 2>/dev/null)
    case "$laneState" in
      DONE* | RUNNING:monitor*) continue ;;
      WAITING:*)
        laneCode=${laneState#WAITING:}
        laneCode=${laneCode%%:*}
        [[ " $WT_CODES_YELLOW $WT_CODES_HOLD " == *" $laneCode "* ]] && continue
        ;;
    esac
    count=$((count + 1))
  done
  echo "$count"
}

# ---- lane spawn helper -----------------------------------------------------
# Args: <slug> <branch> <wt_path> <initial-prompt-or-empty> [tmux-label]
spawn_lane() {
  local s_slug=$1 s_branch=$2 s_wt=$3 s_initial=$4
  local s_label="${5:-$s_slug}"

  # Opportunistic reap from a TCC-granted shell: the launchd wt-gc job cannot
  # read ~/Documents (Operation not permitted) and silently considers 0 lanes.
  if [[ -z "${WT_SKIP_GC:-}" ]] && command -v wt-gc >/dev/null 2>&1; then
    wt-gc --quiet --hours 24 >/dev/null 2>&1 || true
  fi

  # Default agent = Claude via claude-lane ($WT_CLAUDE). Pi only on explicit
  # WT_AGENT_CMD='pi ...' override (tix sets it per ticket root).
  local agent_cmd="${WT_AGENT_CMD:-${WT_CLAUDE:-claude}}"

  # Ultracode is OPT-IN (WT_ULTRACODE=1) since 2026-09-10. A lane's whole brief
  # is one user turn, so every xhigh thinking block stays in context: the 3-day
  # audit of 272 lane sessions put ~35% of ctx growth on retained thinking, and
  # the ultracode reminder is what licensed 9-parallel-fork dispatch on one
  # worktree. Session-level via `--effort ultracode` (claude 2.1.203+; absent
  # from --help but real); appended to agent_cmd (not env) so it survives
  # tmux's env scrubbing and lane-run.sh respawns. Pi lanes untouched.
  local s_resume="${resume_template:-}"
  if [[ "${WT_ULTRACODE:-0}" == "1" && "$agent_cmd" == *claude* ]]; then
    agent_cmd="$agent_cmd --effort ultracode"
  fi

  if [[ "${WT_DRY_RUN:-}" == "1" ]]; then
    echo "wt[dry-run]: would spawn lane"
    echo "  slug:     $s_slug"
    echo "  branch:   $s_branch"
    echo "  base:     $lane_base_ref"
    echo "  worktree: $s_wt"
    [[ -n "$s_initial" ]] && echo "  kickoff:  $s_initial"
    return 0
  fi

  # Concurrency backstop, not a throttle: blocks runaway lane accumulation
  # (2026-07-14: concurrent lane typechecks — cartage-agent `tsc --noEmit`
  # peaks ~5.4GB each — swap-thrashed the 16GB cockpit; memory pressure is
  # handled by the lane-bin typecheck lock, this cap only stops pile-ups).
  # WT_MAX_LANES counts lanes needing attention (count_attention_lanes);
  # WT_MAX_PROCESSES caps every running lane process, held or not, as the
  # memory backstop. WT_MAX_LANES=0 disables both.
  local max_lanes="${WT_MAX_LANES:-10}"
  if (( max_lanes > 0 )); then
    local active_lanes
    active_lanes=$(count_attention_lanes)
    local running_lanes
    running_lanes=$(pgrep -f 'mcp\.lane\.json' 2>/dev/null | wc -l | tr -d ' ') || true
    if (( running_lanes + spawned_this_run >= ${WT_MAX_PROCESSES:-10} )); then
      echo "wt: memory backstop hit — $running_lanes lane processes running (WT_MAX_PROCESSES=${WT_MAX_PROCESSES:-10}). Close finished lanes first." >&2
      return 1
    fi
    if (( active_lanes + spawned_this_run >= max_lanes )); then
      echo "wt: lane cap hit — $active_lanes running + $spawned_this_run spawned this run >= WT_MAX_LANES=$max_lanes. Wait for a lane to finish, or override: WT_MAX_LANES=$((active_lanes + spawned_this_run + 1)) wt ..." >&2
      return 1
    fi
  fi
  spawned_this_run=$((spawned_this_run + 1))

  # If the branch is already checked out in an existing worktree, reuse it —
  # git forbids a second checkout of the same branch (common when picking up
  # feedback on a PR whose lane worktree is still around).
  local existing_wt
  existing_wt=$(git -C "$repo" worktree list --porcelain \
    | awk -v b="refs/heads/$s_branch" '
        /^worktree /{ wt = substr($0, 10) }
        /^branch /{ if ($2 == b && !found) { print wt; found = 1 } }')
  if [[ -n "$existing_wt" ]]; then
    echo "wt: branch '$s_branch' already checked out at $existing_wt — reusing it"
    s_wt="$existing_wt"
  elif [[ ! -d "$s_wt" ]]; then
    # Local branch or remote-only branch (e.g. a PR head fetched into origin/*)
    # → check it out as-is; git DWIMs a tracking branch from origin/<name>.
    # Otherwise create a fresh branch off $lane_base_ref. --no-track: a lane
    # branch based on origin/main must not push back to main.
    if git -C "$repo" rev-parse --verify "$s_branch" >/dev/null 2>&1 \
       || git -C "$repo" rev-parse --verify "origin/$s_branch" >/dev/null 2>&1; then
      git -C "$repo" worktree add "$s_wt" "$s_branch"
    else
      git -C "$repo" branch --no-track "$s_branch" "$lane_base_ref"
      git -C "$repo" worktree add "$s_wt" "$s_branch"
    fi
  fi

  provision_deps "$repo" "$s_wt"
  install_push_guard "$repo"

  # Per-lane port: stamp once. A reused worktree keeps the port it already has.
  # Allocate max(stamped sibling ports)+1, not 3099+dir-count — a dir count
  # shrinks when wt-gc reaps an old lane and would hand a live sibling's port
  # to the next spawn.
  local port=""
  if [[ -f "$s_wt/.env.local.port" ]]; then
    port=$(sed -n 's/^PORT=//p' "$s_wt/.env.local.port" | head -1)
  else
    local port_file sibling_port max_port=3099
    for port_file in "$wt_dir"/*/.env.local.port; do
      [[ -f "$port_file" ]] || continue
      sibling_port=$(sed -n 's/^PORT=//p' "$port_file" | head -1)
      if [[ "$sibling_port" =~ ^[0-9]+$ ]] && (( sibling_port > max_port )); then
        max_port=$sibling_port
      fi
    done
    port=$((max_port + 1))
    printf 'PORT=%s\n' "$port" > "$s_wt/.env.local.port"
  fi

  mkdir -p "$s_wt/.claude"
  echo "IDLE" > "$s_wt/.claude/agent-state"
  # Authoritative label for agent-board. Trusted over tmux window-name walk,
  # which can pick up an unrelated parent window (e.g. cockpit) when the lane
  # was spawned via `pane` layout or launched manually.
  printf '%s\n' "$s_label" > "$s_wt/.claude/tmux-window"

  # Record the cwd that spawned this lane so agent-board can nest spawned
  # lanes under their parent. WT_PARENT_CWD overrides for scripted use.
  printf '%s\n' "${WT_PARENT_CWD:-$PWD}" > "$s_wt/.claude/parent-cwd"

  # Optional: invoke a ticket-status sync on spawn so the ticket's `status:`
  # flips to `active`. WT_TICKET_SYNC may be set to a script accepting a slug
  # arg (e.g. `tix-sync` companion, or your own). Detached + silenced so it
  # never slows the spawn. No-ops cleanly when the slug has no ticket.
  if [[ -n "${WT_TICKET_SYNC:-}" && -x "${WT_TICKET_SYNC}" ]]; then
    ( "$WT_TICKET_SYNC" "$s_slug" >/dev/null 2>&1 & )
  fi

  if [[ ! -f "$s_wt/.claude/settings.local.json" ]]; then
    # Lanes are autonomous: drop cockpit-UX plugins (chat-compression modes,
    # scaffolding helpers) — they cost session-start + per-turn context and
    # serve no headless reader.
    cat > "$s_wt/.claude/settings.local.json" <<'JSON'
{
  "enabledPlugins": {
    "vercel@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": false,
    "caveman@caveman": false
  }
}
JSON
  fi

  local lane_cmd

  # Route through lane-run.sh: it relaunches the agent on HANDOFF:<doc> state
  # (resume template's {DOC}/{N}/{MAX} substituted per respawn) and exits on
  # any other terminal state. Empty template (Pi lanes) → never respawns.
  lane_cmd="$HOME/.claude/scripts/lane-run.sh $(printf '%q' "$s_wt") $(printf '%q' "$agent_cmd") $(printf '%q' "$s_initial") $(printf '%q' "$s_resume")"

  # Every lane gets an auto-attached monitor pane — see CLAUDE.md "Lane
  # observability". Policy: no lane runs unmonitored.
  # Opt out per-spawn with WT_NO_WATCH=1.
  local watch_cmd=""
  if [[ "${WT_NO_WATCH:-0}" != "1" ]]; then
    watch_cmd="$HOME/.claude/scripts/lane-watch.sh $(printf '%q' "$s_wt")"
  fi

  if [[ -n "${TMUX:-}" ]]; then
    case "$layout" in
      pane)
        tmux split-window -h -c "$s_wt" "$lane_cmd"
        tmux select-pane -T "$s_label" 2>/dev/null || true
        [[ -n "$watch_cmd" ]] && tmux split-window -v -c "$s_wt" "$watch_cmd"
        ;;
      window)
        tmux new-window -n "$s_label" -c "$s_wt" "$lane_cmd"
        if [[ -n "$watch_cmd" ]]; then
          tmux split-window -t "$s_label" -h -p 35 -c "$s_wt" "$watch_cmd"
          # Focus the agent pane (left of the just-split watch pane).
          # Don't target "$s_label.0" — fails under `pane-base-index 1`.
          tmux select-pane -t "$s_label" -L 2>/dev/null || true
        fi
        ;;
      session)
        tmux new-session -d -s "wt-$s_label" -c "$s_wt" "$lane_cmd"
        [[ -n "$watch_cmd" ]] && tmux split-window -t "wt-$s_label" -h -p 35 -c "$s_wt" "$watch_cmd"
        echo "wt: detached session 'wt-$s_label'. Attach: tmux attach -t wt-$s_label"
        ;;
      *)
        echo "wt: unknown WT_LAYOUT=$layout (expected pane|window|session)" >&2
        exit 1
        ;;
    esac
  elif command -v tmux >/dev/null 2>&1; then
    # Not inside tmux. Target a dedicated `wt` session (override w/
    # WT_TMUX_SESSION) as the lane's permanent home — one predictable address,
    # no alphabetical guessing. The block below then links it into the user's
    # cockpit for visibility. Create the session if missing, else attach a new
    # window to it. Stops callers (orchestrator agents) from improvising with
    # nohup, which detaches the process from any pane and loses scrollback.
    local target_sess="${WT_TMUX_SESSION:-wt}"
    if tmux has-session -t "$target_sess" 2>/dev/null; then
      tmux new-window -t "$target_sess" -n "$s_label" -c "$s_wt" "$lane_cmd"
      echo "wt: spawned window '$s_label' in tmux session '$target_sess'."
    else
      tmux new-session -d -s "$target_sess" -n "$s_label" -c "$s_wt" "$lane_cmd"
      echo "wt: started tmux session '$target_sess' with window '$s_label'."
    fi
    if [[ -n "$watch_cmd" ]]; then
      tmux split-window -t "$target_sess:$s_label" -h -p 35 -c "$s_wt" "$watch_cmd"
      tmux select-pane -t "$target_sess:$s_label" -L 2>/dev/null || true
      echo "    Monitor pane attached (lane-watch)."
    fi
    # Mirror the lane into whatever session the user is actually attached to
    # (opt out: WT_NO_LINK=1). link-window SHARES one window between sessions
    # rather than moving it, so "$target_sess:$s_label" stays addressable and
    # lane-done.sh's window-id lookup is unaffected. Without this, a lane
    # spawned by an agent — whose Bash tool runs outside tmux, so the branch
    # above always fires — lands in a session nobody is watching.
    if [[ "${WT_NO_LINK:-0}" != "1" ]]; then
      local client_sess next_idx
      client_sess=$(tmux list-clients -F '#{client_session}' 2>/dev/null \
        | grep -vx "$target_sess" | head -1 || true)
      if [[ -n "$client_sess" ]]; then
        next_idx=$(tmux list-windows -t "$client_sess" -F '#{window_index}' 2>/dev/null \
          | sort -n | tail -1 || true)
        next_idx=$(( ${next_idx:-0} + 1 ))
        if tmux link-window -s "$target_sess:$s_label" -t "$client_sess:$next_idx" 2>/dev/null; then
          echo "    Linked into attached session '$client_sess' as window $next_idx."
        fi
      fi
    fi
    echo "    Attach: tmux attach -t $target_sess"
    echo "  worktree: $s_wt"
    echo "  port:     $port"
    echo "  branch:   $s_branch"
  else
    echo "wt: not in tmux and tmux not installed."
    echo "  worktree: $s_wt"
    echo "  port:     $port"
    echo "  branch:   $s_branch"
    [[ -n "$s_initial" ]] && echo "  kickoff:  $lane_cmd"
  fi
}

# ---- lane kickoff prompt fragments ------------------------------------------
# Shared by single-lane and DAG-fallback spawns. Kept terse: the lane re-reads
# its brief/plan and the harness's own instruction file; this prompt only
# carries lane-lifecycle rules the agent can't derive from those.

source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../share/render-prompt.sh"





if [[ "${WT_AGENT_CMD:-${WT_CLAUDE:-claude}}" == *claude* ]]; then
  harness_rule=$(render_prompt harness-claude)
  resume_template=$(render_prompt resume)
else
  harness_rule=$(render_prompt harness-pi)
  resume_template=""
fi

# ---- single-lane mode ------------------------------------------------------

if [[ "$mode" == "single" ]]; then
  wt_path="$wt_dir/$slug"
  branch="${branch_override:-${type_prefix}/${slug}}"

  initial=""
  if [[ -n "$ticket_file" ]]; then
    initial=$(render_prompt kickoff-brief "TICKET_FILE=$ticket_file" "HARNESS=$harness_rule")
  elif [[ -f "$HOME/.claude/plans/${plan_slug}.md" ]]; then
    # No ticket brief, but a plan exists (e.g. /address-feedback writes
    # ~/.claude/plans/PR-<num>-feedback.md). Drive the lane off the plan.
    plan="$HOME/.claude/plans/${plan_slug}.md"
    initial=$(render_prompt kickoff-feedback-plan "PLAN=$plan" "HARNESS=$harness_rule")
  elif [[ -n "$ticket" ]]; then
    initial=$(render_prompt kickoff-no-brief "TICKET=$ticket" "PLAN_SLUG=$plan_slug")
  fi

  spawn_lane "$slug" "$branch" "$wt_path" "$initial" "${ticket:-$slug}"
  exit 0
fi

# ---- DAG modes -------------------------------------------------------------

[[ -z "$ticket" ]] && { echo "wt: --dag/--resolve requires a Linear-style ticket ID" >&2; exit 1; }

dag_parser="$HOME/.claude/scripts/dag-parse.sh"

# Run parser once, splitting stdout (TSV) from stderr (errors) via a temp
# file — two runs would waste a parse and race a concurrent plan edit.
# Export WT_TYPE so dag-parse stamps the right branch prefix.
export WT_TYPE="$type_prefix"
parse_err_file=$(mktemp "${TMPDIR:-/tmp}/wt-dag-parse.XXXXXX")
set +e
tsv=$("$dag_parser" "$ticket" 2>"$parse_err_file")
parse_rc=$?
set -e
parse_err=$(cat "$parse_err_file")
rm -f "$parse_err_file"

case "$parse_rc" in
  0) : ;;
  2)
    echo "wt: $parse_err" >&2
    exit 2
    ;;
  3)
    echo "wt: no slice-dag block in plan — falling back to single-lane mode" >&2
    wt_path="$wt_dir/$slug"
    branch="${type_prefix}/${slug}"
    plan="$HOME/.claude/plans/${plan_slug}.md"
    initial=$(render_prompt kickoff-plan "PLAN=$plan" "HARNESS=$harness_rule")
    spawn_lane "$slug" "$branch" "$wt_path" "$initial" "$ticket"
    exit 0
    ;;
  4)
    echo "wt: $parse_err" >&2
    exit 4
    ;;
  *)
    echo "wt: dag-parse failed (rc=$parse_rc): $parse_err" >&2
    exit "$parse_rc"
    ;;
esac

[[ -z "$tsv" ]] && { echo "wt: dag-parse returned no slices" >&2; exit 4; }

slice_count=$(printf '%s\n' "$tsv" | wc -l | tr -d ' ')
if [[ "$slice_count" -le 1 ]]; then
  echo "wt: only one slice in DAG — falling back to single-lane mode"
  wt_path="$wt_dir/$slug"
  branch="${type_prefix}/${slug}"
  plan="$HOME/.claude/plans/${plan_slug}.md"
  initial=$(render_prompt kickoff-single-slice "PLAN=$plan")
  spawn_lane "$slug" "$branch" "$wt_path" "$initial" "$ticket"
  exit 0
fi

# Determine which slices are already merged. Heuristic:
#   - branch <type>/<slug>-<id> exists AND is reachable from feature branch HEAD,
#     OR
#   - branch doesn't exist but a marker file says merged (future-proofing).
# Feature branch == <type>/<slug> (matches single-lane convention; for DAG plans
# this is the integration branch the slice lanes merge into).
feature_branch="${type_prefix}/${slug}"
feature_ref=""
if git -C "$repo" rev-parse --verify "$feature_branch" >/dev/null 2>&1; then
  feature_ref="$feature_branch"
else
  # Cockpit HEAD is the implicit base; treat its history as "merged".
  feature_ref="HEAD"
fi

# DAG slice lanes merge into the integration branch — base new slice branches
# on it, not on origin's default branch. An explicit --base/WT_BASE still wins.
if [[ "$feature_ref" != "HEAD" && -z "$base_override" ]]; then
  lane_base_ref="$feature_ref"
fi

is_merged() {
  local s_branch=$1
  git -C "$repo" rev-parse --verify "$s_branch" >/dev/null 2>&1 || return 1
  git -C "$repo" merge-base --is-ancestor "$s_branch" "$feature_ref" 2>/dev/null
}

# Build parallel arrays (bash 3.2 — no associative).
ids=();    names=();   needs_arr=(); touches_arr=(); uvs=(); branches=()
while IFS=$'\t' read -r s_id s_name s_needs s_touches s_uv s_branch; do
  [[ -z "$s_id" ]] && continue
  # "-" sentinel from parser → empty.
  [[ "$s_needs" == "-" ]] && s_needs=""
  [[ "$s_touches" == "-" ]] && s_touches=""
  [[ "$s_uv" == "-" ]] && s_uv=""
  ids+=("$s_id"); names+=("$s_name"); needs_arr+=("$s_needs")
  touches_arr+=("$s_touches"); uvs+=("$s_uv"); branches+=("$s_branch")
done <<< "$tsv"

n=${#ids[@]}

# Compute merged set (by slice id) and worktree-exists set.
merged_ids=""
inflight_ids=""
for ((i=0; i<n; i++)); do
  if is_merged "${branches[$i]}"; then
    merged_ids="$merged_ids ${ids[$i]}"
  fi
  s_wt="$wt_dir/${slug}-${ids[$i]}"
  if [[ -d "$s_wt" ]]; then
    inflight_ids="$inflight_ids ${ids[$i]}"
  fi
done

contains() { case " $1 " in *" $2 "*) return 0;; *) return 1;; esac; }

# Build candidate ready set: needs all merged, not already merged, not in flight.
ready_idx=()
for ((i=0; i<n; i++)); do
  contains "$merged_ids" "${ids[$i]}" && continue
  contains "$inflight_ids" "${ids[$i]}" && continue
  needs="${needs_arr[$i]}"
  ok=1
  if [[ -n "$needs" ]]; then
    IFS=',' read -r -a need_list <<< "$needs"
    for n_id in "${need_list[@]}"; do
      [[ -z "$n_id" ]] && continue
      if ! contains "$merged_ids" "$n_id"; then ok=0; break; fi
    done
  fi
  [[ "$ok" == "1" ]] && ready_idx+=("$i")
done

if [[ ${#ready_idx[@]} -eq 0 ]]; then
  if [[ -n "$inflight_ids" ]]; then
    echo "wt: no newly-ready slices. In flight:$inflight_ids" >&2
  else
    echo "wt: no ready slices (all merged or all blocked)" >&2
  fi
  exit 0
fi

# Conflict-check: serialize any ready pair that shares a touches path.
# Simpler: drop slice j if its touches set intersects an earlier ready slice's.
spawn_idx=()
spawn_touches=()
for i in "${ready_idx[@]}"; do
  conflict=0
  IFS=',' read -r -a my_paths <<< "${touches_arr[$i]}"
  for prev in "${spawn_touches[@]:-}"; do
    [[ -z "$prev" ]] && continue
    IFS=',' read -r -a prev_paths <<< "$prev"
    for p in "${my_paths[@]}"; do
      [[ -z "$p" ]] && continue
      for q in "${prev_paths[@]}"; do
        [[ -z "$q" ]] && continue
        if [[ "$p" == "$q" ]]; then conflict=1; break 3; fi
      done
    done
  done
  if [[ "$conflict" == "1" ]]; then
    echo "wt: deferring ${ids[$i]} (touches conflict with sibling ready slice)" >&2
  else
    spawn_idx+=("$i")
    spawn_touches+=("${touches_arr[$i]}")
  fi
done

if [[ "$mode" == "resolve" ]]; then
  echo "wt --resolve $ticket: merged={$merged_ids } inflight={$inflight_ids } spawning ${#spawn_idx[@]}"
else
  echo "wt --dag $ticket: spawning ${#spawn_idx[@]} ready slice(s)"
fi

plan_path="$HOME/.claude/plans/${plan_slug}.md"

for i in "${spawn_idx[@]}"; do
  s_id="${ids[$i]}"
  s_name="${names[$i]}"
  s_branch="${branches[$i]}"
  s_slug="${slug}-${s_id}"
  s_wt="$wt_dir/${s_slug}"
  s_initial=$(render_prompt kickoff-dag-slice "PLAN_PATH=$plan_path" "SLICE_ID=$s_id" "SLICE_NAME=$s_name" "TICKET=$ticket")
  spawn_lane "$s_slug" "$s_branch" "$s_wt" "$s_initial" "${ticket}-${s_id}"
done
