#!/usr/bin/env bash
# Installed by `wt` as <repo>/.git/hooks/pre-push (a symlink, so every worktree of
# the repo — lane or cockpit — runs it). Runs the repo's CI guards before any push
# and blocks the push when one is red, so a guard failure never reaches GitHub,
# where it would fire a review round and come back minutes later as a red
# pr-checks nothing in the lane reads (2026-11-04: 6 of 6 red lane PRs were guards).
# A repo without gates/prChecks/runGuards.ts has nothing to run and pushes as before.
# WT_SKIP_GUARDS=1 skips it for a person who knows why; lanes never set it.
#
# It must finish in seconds: git opens the SSH connection BEFORE this hook runs and
# GitHub drops a connection that idles for minutes ("Connection to github.com closed
# by remote host", exit 141, after the guards had passed). The first version ran
# runGuards.ts whole behind a lock; nine lane pushes queued behind one 100s run and
# every one of them lost its connection. So: the guard list is read from runGuards.ts
# (no second list to drift), the hang detector is skipped — it is sized for the CI
# runner and takes 90-115s here — and the rest run in parallel, ~5s, no lock.
# macOS bash 3.2 compatible.

set -u

[[ "${WT_SKIP_GUARDS:-}" == "1" ]] && exit 0

toplevel=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
runner="$toplevel/gates/prChecks/runGuards.ts"
[[ -f "$runner" ]] || exit 0

while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [[ "$local_sha" =~ ^0+$ ]] && continue
  has_push=1
done
[[ -n "${has_push:-}" ]] || exit 0

skipped_guards="credless-test-hermetic"

cd "$toplevel" || exit 0
guard_names=$(bun -e 'import { GUARDS } from "./gates/prChecks/runGuards.ts"; console.log(Object.keys(GUARDS).join("\n"))' 2>/dev/null)
if [[ -z "$guard_names" ]]; then
  echo "pre-push: could not read the guard list from gates/prChecks/runGuards.ts — pushing unguarded" >&2
  exit 0
fi

echo "pre-push: running the CI guards before the push (skipping: $skipped_guards)" >&2
log_dir=$(mktemp -d -t wt-guards)
run_one() {
  local name=$1
  bun run "check:$name" > "$log_dir/$name.log" 2>&1
  echo "$name $?" >> "$log_dir/verdicts"
}
export -f run_one
export log_dir
printf '%s\n' "$guard_names" | grep -vxF "$skipped_guards" | xargs -P 4 -I{} bash -c 'run_one "$1"' _ {}

failed=$(awk '$2 != 0 { print $1 }' "$log_dir/verdicts" | sort)
if [[ -z "$failed" ]]; then
  rm -rf "$log_dir"
  exit 0
fi

echo "pre-push: PUSH REFUSED — CI guards are red: $(printf '%s' "$failed" | tr '\n' ' ')" >&2
echo "Fix every failure below, commit, push again." >&2
for name in $failed; do
  printf '\n## %s — FAIL\n' "$name" >&2
  cat "$log_dir/$name.log" >&2
done
echo "guard logs: $log_dir" >&2
exit 1
